# PostgreSQL ulanish satri (async driver — asyncpg)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/stars_shop

# Bot bilan bir xil bo'lishi shart — bot.env dagi API_INTERNAL_SECRET bilan mos kelishi kerak
API_INTERNAL_SECRET=change-me-to-a-long-random-string

# Veb Admin Panel shu parol bilan kiradi (bot kalitidan alohida)
ADMIN_PANEL_PASSWORD=choose-a-strong-admin-password

# Referal bonusi (Stars birligida). 0 bo'lsa bonus berilmaydi.
REFERRAL_BONUS_STARS=50

# stars-bot loyihasidagi BOT_TOKEN bilan bir xil bo'lishi kerak
# (Mini App initData'sini tekshirish va Stars invoice link yaratish uchun ishlatiladi)
BOT_TOKEN=123456789:AAExampleTokenHere

# Mini App frontend manzili (CORS uchun). Development uchun * qoldirishingiz mumkin.
FRONTEND_ORIGIN=https://your-mini-app.example.com
# Admin panel manzili (CORS uchun)
ADMIN_PANEL_ORIGIN=https://your-admin-panel.example.com

PORT=8000
